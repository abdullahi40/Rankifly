# Copy this to .env and fill with your real deployment values.
# Do not commit real secrets to git.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=Rankifly
DB_USER=postgres
DB_PASSWORD=your_local_db_password
DATABASE_URL=postgresql://postgres:your_local_db_password@localhost:5432/Rankifly

JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=7d

WHOP_CLIENT_ID=your_whop_client_id
WHOP_CLIENT_SECRET=your_whop_client_secret
WHOP_REDIRECT_URI=http://localhost:5000/api/v1/auth/callback
WHOP_API_URL=https://api.whop.com
WHOP_API_TOKEN=your_whop_api_token
WHOP_WEBHOOK_SECRET=your_whop_webhook_secret
WHOP_RANKIFLY_PRO_CHECKOUT_URL=https://whop.com/checkout/plan_HpyCNBkz8Cymm
WHOP_CHECKOUT_URL=https://whop.com/checkout/plan_HpyCNBkz8Cymm
WHOP_PRODUCT_URL=https://whop.com/checkout/plan_HpyCNBkz8Cymm

FRONTEND_URL=http://localhost:3000
PORT=5000
NODE_ENV=development
